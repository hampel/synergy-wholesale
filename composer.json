{
    "name": "hampel/synergy-wholesale",
    "description": "Synergy Wholesale API client, generated from the published WSDL",
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/hampel/synergy-wholesale/issues",
        "source": "https://github.com/hampel/synergy-wholesale"
    },
    "keywords": [
        "Synergy Wholesale",
        "domains",
        "DNS",
        "SSL",
        "API",
        "SOAP"
    ],
    "homepage": "https://github.com/hampel/synergy-wholesale",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-soap": "*",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "hampel/rig": "^0.2",
        "laravel/pint": "^1.30",
        "phpstan/phpstan": "^2.1.22",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "hampel/synergy-wholesale-laravel": "Laravel service provider and facade for this client"
    },
    "autoload": {
        "psr-4": {
            "Hampel\\SynergyWholesale\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hampel\\SynergyWholesale\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": "pint --test",
        "generate": "php tools/generate-api.php",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
